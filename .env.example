# Database configuration (async driver)
DATABASE_URL=sqlite+aiosqlite:///./memoai.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Authentication - required, generate a long random value:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-random-jwt-secret
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini API (free tier) - https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq API (free tier) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Cloudinary config - https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS origins (JSON array)
CORS_ORIGINS=["*"]

# Environment: development | production
ENVIRONMENT=development

# Server port
PORT=8000