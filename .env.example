# Database configuration (async driver)
DATABASE_URL=sqlite+aiosqlite:///./memoai.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Authentication - required, generate a long random value:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-random-jwt-secret
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini API (free tier) - https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq API (free tier) - https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Backblaze B2 object storage (optional, keeps the app free).
# Leave empty to store videos locally under data/uploads (dev/test).
# https://www.backblaze.com/cloud-storage
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Local fallback directory for stored files
STORAGE_DIR=data/uploads

# CORS origins (JSON array)
CORS_ORIGINS=["*"]

# Environment: development | production
ENVIRONMENT=development

# Server port
PORT=8000