# ---------------------------------------------------------------------------
# MemoAI configuration
#
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# Async SQLAlchemy URL. SQLite is the default; PostgreSQL is supported.
DATABASE_URL=sqlite+aiosqlite:///./memoai.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Authentication ----------------------------------------------------------
# REQUIRED. Generate a long random value (>= 32 chars, no placeholder words):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional: dedicated secrets for email-verification / password-reset tokens.
# Leave empty to reuse JWT_SECRET.
VERIFICATION_TOKEN_SECRET=
RESET_PASSWORD_TOKEN_SECRET=

# --- Email delivery (Resend) -------------------------------------------------
# REQUIRED in production (ENVIRONMENT=production). Leave empty in development:
# the verification URL is then printed to the server logs instead of emailed.
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM=MemoAI <noreply@memo-ai.app>
# Public base URL of this API, used to build email links. MUST be a real URL
# in production (the app refuses to start without it).
PUBLIC_BASE_URL=http://localhost:8000

# --- AI providers ------------------------------------------------------------
# Gemini (free tier) - https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Groq (free tier) - https://console.groq.com
GROQ_API_KEY=

# --- Object storage (Backblaze B2, optional) ---------------------------------
# Empty credentials fall back to local disk under STORAGE_DIR (dev/test only).
# https://www.backblaze.com/cloud-storage
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Optional; derived from B2_ENDPOINT_URL when empty.
B2_REGION=
STORAGE_DIR=data/uploads

# --- CORS ---------------------------------------------------------------------
# JSON array of allowed origins. Exchange the wildcard for your app origin in
# production (the app refuses to start in production with "*").
CORS_ORIGINS=["*"]

# --- Environment --------------------------------------------------------------
# development | production
# In production the app enforces: PUBLIC_BASE_URL set, RESEND_API_KEY set,
# rate limiting enabled, and CORS_ORIGINS not equal to "*" (startup failure if not).
ENVIRONMENT=development

# --- Rate limiting (in-memory, per process) ------------------------------------
RATE_LIMITING_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=60/minute
RATE_LIMIT_UPLOAD=10/minute

# --- Uploads --------------------------------------------------------------------
# Maximum video upload size in bytes (default 300 MB).
MAX_UPLOAD_BYTES=314572800

# --- Networking ----------------------------------------------------------------
PORT=8000
# Force IPv4 for all outbound connections (needed when the host IPv6 route is broken).
NET_IPV4_ONLY=false